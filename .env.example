# --- Server ---
PORT=3000
# Shared secret required on every write/read API call (header: x-portal-key).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
PORTAL_KEY=

# --- Data ---
# Full-access Postgres connection string used by the web app and migrations.
DATABASE_URL=
# Least-privilege connection string used by the MCP server (SELECT everywhere, INSERT on follow_ups only).
# Created by:  npm run db:role
MCP_DATABASE_URL=
# Bearer token that remote MCP clients present to /mcp (separate from PORTAL_KEY; grants tool access only).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
MCP_BEARER_TOKEN=
# IANA timezone used for "today" / "this week" queries.
BUSINESS_TIMEZONE=America/New_York

# --- Integrations ---
OPENAI_API_KEY=
# Make.com scenario that emails the service summary PDF + photos to the customer.
MAKE_WEBHOOK_URL=
# Optional: Make.com scenario that sends an approved follow-up email (JSON body: to, subject, body, jobId).
MAKE_FOLLOWUP_WEBHOOK_URL=

# --- Demo ---
# Public base URL of the deployed app (used in MCP tool responses to link to the approval page).
APP_BASE_URL=http://localhost:3000
